# Modelo das variáveis do api-tcc. Só os NOMES: os valores ficam no seu arquivo de ambiente (que nunca vai para o git).

# Banco (obrigatórias)
IP_BANCO=
PORTA_BANCO=
NOME_BANCO=
USER_BANCO=
SENHA_BANCO=

# Usuários separados (opcionais; sem eles, usa USER_BANCO/SENHA_BANCO)
USER_ESCRITA=
SENHA_ESCRITA=
USER_LEITURA=
SENHA_LEITURA=

# Publicador
PROC_DIR_PROCESSAMENTO=

# API
PROC_API_CHAVES=
PROC_API_CORS_ORIGENS=
# Chave usada pelo ferramentas/conferir_api.py (opcional; sem ela, usa a primeira de PROC_API_CHAVES)
PROC_API_CHAVE_CONFERIR=

# Testes (deixe vazios no dia a dia)
PROC_API_PREFIXO_TABELAS=
PROC_API_TESTES_COM_BANCO=

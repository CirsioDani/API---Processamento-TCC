{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Glob(**/.env)",
      "Glob(**/.env.*)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Bash(*.env*)",
      "PowerShell(*.env*)"
    ]
  }
}
